circ.getsarf.xyz {
	# Circ Launchpad by Sarf: static front end. Files: /srv/circ-web (source: web/ in the repo).
	# Keyless indexer JSON under /data (systemd circ-indexer). No Sarf services behind this.
	encode gzip
	redir /staging /staging/ 308
	header /data/* Cache-Control "no-store"
	header /staging/data/* Cache-Control "no-store"
	header /staging/hidelist.json Cache-Control "no-store"
	header /hidelist.json Cache-Control "no-store"
	header /*.js Cache-Control "no-cache"
	header /*.css Cache-Control "no-cache"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: blob: https://ipfs.filebase.io https://dweb.link https://*.ipfs.dweb.link; connect-src 'self' https://rpc.xlayer.tech https://xlayerrpc.okx.com https://circ-launchpad-pin.vercel.app; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
	# Staging copy of the site, on the CIRC-TEST pad (deploy/publish-web.sh staging)
	handle_path /staging/* {
		root * /srv/circ-staging
		file_server
	}
	handle {
		root * /srv/circ-web
		file_server
	}
}
