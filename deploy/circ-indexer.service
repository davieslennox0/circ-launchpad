[Unit]
Description=Circ public indexer (keyless; writes /srv/circ-web/data/index-*.json for pitchook.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OUT_DIR=/srv/circ-web/data
Environment=RPC_URL=https://rpc.xlayer.tech
ExecStart=/usr/bin/python3 -I -u /root/circ/web/indexer.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/circ-indexer.log
StandardError=append:/var/log/circ-indexer.log
MemoryHigh=48M
MemoryMax=64M
Nice=10

[Install]
WantedBy=multi-user.target
